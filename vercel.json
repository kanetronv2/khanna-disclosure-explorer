{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "redirects": [
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "khanna-disclosure-explorer.vercel.app" }],
      "destination": "https://www.rokhanna.money/:path*",
      "permanent": true
    },
    {
      "source": "/",
      "has": [
        { "type": "query", "key": "year", "value": "(?<year>201[6-9]|202[0-35-6])" }
      ],
      "destination": "/:year/",
      "permanent": true
    },
    { "source": "/2024", "destination": "/", "permanent": true },
    { "source": "/2024/:path*", "destination": "/", "permanent": true }
  ],
  "headers": [
    {
      "source": "/ocr/pages/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/docs/(.*)/pages/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/site-data/(.*).([a-f0-9]{12}).json",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/site-data/summaries.js",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=300, stale-while-revalidate=86400" }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" }
      ]
    }
  ]
}
